# ==============================================================================
# UniSIRAJ CIA Helpdesk Agent - Environment Configuration Example
# Universiti Islam Antarabangsa Tuanku Syed Sirajuddin (UniSIRAJ)
# ==============================================================================

# Application Environment
ENVIRONMENT=development
APP_NAME="UniSIRAJ CIA Helpdesk Agent Backend"
API_V1_PREFIX="/api/v1"
DEBUG=true

# Database Configuration
# Local SQLite fallback:
DATABASE_URL=sqlite:///./unisiraj_cia.db
# Local PostgreSQL:
# DATABASE_URL=postgresql://unisiraj_user:CHANGE_ME_PASSWORD@localhost:5432/unisiraj_cia_db
# Google Cloud SQL (Unix Domain Socket on Cloud Run):
# DATABASE_URL=postgresql://unisiraj_user:DB_PASSWORD@/unisiraj_cia_db?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME

# Security & JWT Authentication
# Generate strong 256-bit random key: openssl rand -hex 32
JWT_SECRET_KEY=dev_secret_key_unisiraj_cia_min_32_characters_long_replace_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Initial Bootstrap Administrator (Disabled in production after initial setup)
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@unisiraj.edu.my
BOOTSTRAP_ADMIN_PASSWORD=AdminSecurePassword123!
BOOTSTRAP_ADMIN_NAME="CIA System Administrator"

# WhatsApp Notifications (Twilio)
# Set to 'mock' for local development & automated testing (no charges)
# Set to 'twilio' for real WhatsApp sandbox or production business profile
TWILIO_PROVIDER=mock
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_STATUS_CALLBACK_URL=https://your-cloud-run-service.run.app/api/v1/webhooks/twilio/status

# Google Gemini AI Assistant
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Visa Expiry Monitoring Rules (Configurable threshold milestones in days)
REMINDER_MILESTONES="90,60,30"
DEFAULT_TIMEZONE="Asia/Kuala_Lumpur"

# CORS Configuration (Comma-separated allowed frontend origins or * for open dev)
ALLOWED_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Live Real-Time SMTP Email Dispatch (Google Workspace, Gmail, or University Mail Relay)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=cia.helpdesk@unisiraj.edu.my
SMTP_PASSWORD=your_app_specific_password_here
SMTP_FROM_NAME="UniSIRAJ CIA Helpdesk"
SMTP_FROM_EMAIL=cia.helpdesk@unisiraj.edu.my
SMTP_REPLY_TO=cia.helpdesk@unisiraj.edu.my
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Frontend Single-Page App (SPA) Serving on Cloud Run
# FRONTEND_DIST_DIR=/app/dist
